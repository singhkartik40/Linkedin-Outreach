{
  "name": "outreach-desk",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-smoke.cjs",
    "test:extension": "node tests/extension-browser.cjs",
    "lint:security": "eslint .",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
